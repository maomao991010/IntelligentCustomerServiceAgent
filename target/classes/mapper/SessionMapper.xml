<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ticketing.dao.SessionDao">
    <select id="selectByActivityId" resultType="com.ticketing.entity.Session">
        SELECT * FROM session WHERE activity_id = #{activityId}
    </select>
    <select id="selectById" resultType="com.ticketing.entity.Session">
        SELECT * FROM session WHERE id = #{id}
    </select>
    <select id="selectSessionPageWithSearch" resultType="com.ticketing.entity.Session">
        SELECT * FROM session
        <if test="keyword != null and keyword != ''">
            WHERE activity_name LIKE CONCAT('%', #{keyword}, '%')
            OR venue LIKE CONCAT('%', #{keyword}, '%')
            OR artist LIKE CONCAT('%', #{keyword}, '%')
        </if>
        ORDER BY create_time DESC
    </select>
    <select id="selectSessionPageWithArtistAndLocation" resultType="com.ticketing.entity.Session">
        SELECT * FROM session
        WHERE 1=1
        <if test="artist != null and artist != ''">
            AND (artist LIKE CONCAT('%', #{artist}, '%') OR activity_name LIKE CONCAT('%', #{artist}, '%'))
        </if>
        <if test="location != null and location != ''">
            AND venue LIKE CONCAT('%', #{location}, '%')
        </if>
        ORDER BY create_time DESC
    </select>
</mapper>
