<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ticketing.dao.SeatDao">
    <select id="selectBySessionId" resultType="com.ticketing.entity.Seat">
        SELECT * FROM seat WHERE session_id = #{sessionId}
    </select>
    <select id="selectBySessionIdAndStatus" resultType="com.ticketing.entity.Seat">
        SELECT * FROM seat WHERE session_id = #{sessionId} AND status = #{status}
    </select>
    <delete id="deleteBySessionId">
        DELETE FROM seat WHERE session_id = #{sessionId}
    </delete>
</mapper>
