# ========================================
# 环境变量配置文件
# 使用方法：
# 1. 复制此文件为 .env
# 2. 填写你的 API Keys
# 3. 运行 deploy.bat
# ========================================

# DeepSeek API Key
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 通义千问 API Key
# 获取地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# 文心一言 API Key
# 获取地址：https://console.bce.baidu.com/qianfan/
QIANFAN_API_KEY=
QIANFAN_SECRET_KEY=

# Qdrant API Key（如需要）
QDRANT_API_KEY=
